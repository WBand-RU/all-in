@page "/"
@using WBand.Dev.Services
@inject ServiceInfoManager serviceInfoManager
@inject ProcessManager processManager

<PageTitle>Home</PageTitle>

<h1>Services</h1>




<table class="table table-bordered table-hover table-striped">
	<thead>
		<tr>
			<th>
				Name
			</th>
			<th>
				Status
			</th>
		</tr>
	</thead>
	<tbody>
		@foreach (var service in serviceInfoManager.Services)
		{
			<tr>
				<td>
					@service.ServiceName
				</td>
				<td>
					@(service.Health ? "Health" : "Dead")
				</td>
			</tr>
		}
	</tbody>
</table>

@code
{
	protected override async Task OnInitializedAsync()
	{
		try
		{
			serviceInfoManager.OnChanged += HandleChanged;
		}
		catch (Exception ex)
		{

		}
	}

	private void HandleChanged()
	{
		StateHasChanged();
	}
}