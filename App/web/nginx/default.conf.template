server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    location = /health {
        access_log off;
        default_type text/plain;
        return 200 "healthy\n";
    }

    # Authentication and API requests belong to the BFF entry point.
    location ~ ^/(auth|api|band-api|song-api|playlist-api|playback-api|stem-api|mixer-api|files)(/|$) {
        return 404;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
